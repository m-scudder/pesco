<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- New bank/UPI alerts as they arrive, and a one-time import of recent ones. -->
  <uses-permission android:name="android.permission.RECEIVE_SMS" />
  <uses-permission android:name="android.permission.READ_SMS" />
  <application>
    <!-- Runs even when PESCO is closed. Only the system (BROADCAST_SMS holder) can send to it. -->
    <receiver
      android:name="expo.modules.pescocapture.SmsReceiver"
      android:exported="true"
      android:permission="android.permission.BROADCAST_SMS">
      <intent-filter>
        <action android:name="android.provider.Telephony.SMS_RECEIVED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
